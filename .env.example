# Public Supabase project values. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Easy Food owner authentication. Put real values in Vercel, never in source control.
ADMIN_EMAIL=bukharaofficial321@gmail.com
ADMIN_INITIAL_PASSWORD=123456
# Optional. If set, the admin login screen's one-time code must match this value.
ADMIN_ACCESS_CODE=

# Server-only Supabase credential. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only payment integration settings. Never prefix secrets with NEXT_PUBLIC_.
EASYFOOD_PAYMENT_PROVIDER=
EASYFOOD_PAYMENT_INIT_URL=
EASYFOOD_PAYMENT_WEBHOOK_SECRET=

# Server-only notification provider settings.
EASYFOOD_NOTIFICATION_PROVIDER=
EASYFOOD_NOTIFICATION_API_URL=
EASYFOOD_NOTIFICATION_API_KEY=

# Optional production URL used by callbacks.
NEXT_PUBLIC_SITE_URL=
